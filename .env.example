# IA remota opcional compatible con OpenAI Chat Completions.
# Si ENDPOINT y MODEL quedan vacíos, MaestroArch usa el compilador local gratuito.
MAESTROARCH_AI_ENDPOINT=
MAESTROARCH_AI_MODEL=
MAESTROARCH_AI_PROVIDER=
MAESTROARCH_AI_API_KEY=
MAESTROARCH_AI_TIMEOUT_MS=20000

# Entrega GitHub opcional.
# Nunca versionar el valor real del token.
GITHUB_TOKEN=
# Repo destino por defecto para el control plane. Ej.: usuario/producto-generado
MAESTROARCH_GITHUB_REPOSITORY=

# Deploy Vercel opcional. El control plane no lo necesita para construir/validar.
# Nunca versionar el valor real.
VERCEL_TOKEN=
